{
  // The only structures generated anywhere, named so no Skyblock Builder default ever brings one back:
  // the Nether's fortresses and the End's cities. The Overworld has none, so no stronghold (ADR 0012).
  "structuresToGenerate": {
    "allow_list": true,
    "elements": [
      "minecraft:fortress",
      "minecraft:end_city"
    ]
  },

  // The only features generated: the dragon's obsidian towers, so the first fight has them, the
  // return gateways of the outer End, as Skyblock Builder's defaults keep, and chorus on its highlands.
  "featuresToGenerate": {
    "allow_list": true,
    "elements": [
      "minecraft:end_spike",
      "minecraft:end_gateway_return",
      "minecraft:chorus_plant"
    ]
  }
}
