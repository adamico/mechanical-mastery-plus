{
  // The Overworld is void around its islands. The Nether is a lava sea and the End an end stone plain
  // (world.json5); both open to a team with its fourth win (ADR 0012).
  "Overworld": {
    "isCustom": true
  },

  "Nether": {
    "isCustom": true
  },

  // The End keeps its main island, so the dragon and the way home are there.
  "End": {
    "isCustom": true,
    "keepMainIsland": true
  }
}
