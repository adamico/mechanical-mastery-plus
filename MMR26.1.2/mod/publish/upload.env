#
# Where the tokens of the libworks plugin's upload task live in 1Password. These are references, not secrets:
#   the upload runs itself through op run --env-file=publish/upload.env when a token is missing.
# The tokens are the account's, not a project's, so every Module shares Beltworks' items.
MODRINTH_TOKEN=op://Private/Beltworks Modrinth/credential
CURSEFORGE_TOKEN=op://Private/Beltworks CurseForge/credential
